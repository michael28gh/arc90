# Public production URL, for example:
# SITE_URL=https://arc90.app
SITE_URL=

# Stripe server-side values. Never put these in frontend JS.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Webhook verification for server-side entitlements.
STRIPE_WEBHOOK_SECRET=

# Supabase account sign-in and server-only database access.
SUPABASE_URL=
# Public publishable/anon key only, never the service-role key.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live coach. All values below stay server-side.
OPENAI_API_KEY=
COACH_MODEL=gpt-4o-mini
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Existing background reminders.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
