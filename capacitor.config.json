{
  "appId": "com.arc90.app",
  "appName": "Arc90",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "backgroundColor": "#111315",
  "ios": {
    "backgroundColor": "#111315",
    "contentInset": "never",
    "scheme": "Arc90"
  },
  "plugins": {
    "LiveUpdate": {
      "autoBlockRolledBackBundles": true,
      "autoDeleteBundles": true,
      "autoUpdateStrategy": "none",
      "publicKey": "-----BEGIN PUBLIC KEY-----\\n-----END PUBLIC KEY-----",
      "readyTimeout": 10000
    }
  }
}
